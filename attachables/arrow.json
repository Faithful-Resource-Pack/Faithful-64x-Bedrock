{
  "format_version": "1.21.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:arrow",
      "min_engine_version": "1.21.0",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/arrow",
        "enchanted": "textures/misc/enchanted_item_glint",
        "item": "textures/items/arrow"
      },
      "geometry": {
        "default": "geometry.snowball_item_size"
      },
      "animations": {
        "first_person_hold": "animation.snowball_player_item.first_person_hold",
        "third_person_hold": "animation.snowball_player_item.third_person_hold",
        "flying": "animation.snowball_entity"
      },
      "scripts": {
        "animate": [
          {
            "flying": "!q.is_attached"
          },
          {
            "first_person_hold": "!c.is_first_person"
          },
          {
            "third_person_hold": "c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        {
          "controller.render.arrow": "!q.is_attached"
        },
        {
          "controller.render.item_size.animate": "q.is_attached"
        }
      ]
    }
  }
}